{
    "name": "rapttor/yii2-glass",
    "description": "The Rapttor glass UI for Yii2: refractive glass app shell, Vue components, panels and docks, light and dark, no JavaScript build step",
    "type": "yii2-extension",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.54"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "rapttor/yii2-themes": "Colour sets and page backgrounds; the shell uses them when the themes component is registered"
    },
    "autoload": {
        "psr-4": {
            "rapttor\\glass\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rapttor\\glass\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "css": [
            "npx --yes sass@1.108.2 --no-source-map --style=expanded --quiet scss/glass.scss assets/css/glass.css",
            "npx --yes sass@1.108.2 --no-source-map --style=expanded --quiet demo/scss/demo.scss demo/demo.css"
        ]
    }
}
